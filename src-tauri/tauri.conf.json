{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Acchiappaspettri",
  "version": "3.0.0-rc.1",
  "identifier": "io.github.lorebiri.acchiappaspettri",
  "build": {
    "frontendDist": "../dist-desktop",
    "beforeBuildCommand": "node scripts/prepare-desktop.js",
    "beforeDevCommand": "node scripts/prepare-desktop.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Acchiappaspettri",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "createUpdaterArtifacts": true,
    "category": "Education",
    "shortDescription": "Spectra and chromatograms: clean plots and scientific analysis",
    "longDescription": "Acchiappaspettri turns spectra and chromatograms (FTIR, Raman, UV-Vis, fluorescence, HPLC, XRF, LIBS, TGA, DSC, NMR, EPR) saved as files into clean plots and scientific analysis. Data stay on your computer.",
    "copyright": "© 2026 Lorenzo Birindelli. Software libero: GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "acchspettri"
        ],
        "name": "Acchiappaspettri project",
        "description": "Acchiappaspettri project",
        "role": "Editor",
        "mimeType": "application/vnd.acchiappaspettri.project+zip"
      },
      {
        "ext": [
          "ch"
        ],
        "name": "Agilent ChemStation chromatogram",
        "description": "Agilent ChemStation/OpenLab chromatogram",
        "role": "Viewer",
        "mimeType": "application/x-agilent-chemstation-ch"
      },
      {
        "ext": [
          "uv"
        ],
        "name": "Agilent ChemStation DAD spectra",
        "description": "Agilent ChemStation DAD spectra",
        "role": "Viewer",
        "mimeType": "application/x-agilent-chemstation-uv"
      },
      {
        "ext": [
          "jdx",
          "dx",
          "jcamp"
        ],
        "name": "JCAMP-DX spectrum",
        "description": "JCAMP-DX spectrum",
        "role": "Viewer",
        "mimeType": "chemical/x-jcamp-dx"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Italian",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "science",
        "desktopTemplate": "linux/acchiappaspettri.desktop",
        "files": {
          "/usr/share/mime/packages/acchiappaspettri.xml": "linux/acchiappaspettri-mime.xml",
          "/usr/share/doc/acchiappaspettri/copyright": "linux/copyright"
        }
      }
    },
    "publisher": "Lorenzo Birindelli",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../dist-desktop/licenze/LICENSE.txt": "LICENSE.txt",
      "../dist-desktop/licenze/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "license": "GPL-3.0-or-later"
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDQkQ0MzAxMjFFQjJCMjcKUldRbksrc2hBVU85UFBLVmFETkh1a2lPRU1BM1FKMFpwRmhYcVhTSE1mYnpGZUhUVFMwQi9iVEQK",
      "endpoints": [
        "https://github.com/lorebiri/acchiappaspettri/releases/latest/download/latest.json"
      ]
    }
  }
}
