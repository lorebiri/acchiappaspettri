{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permessi minimi della finestra principale",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:menu:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:allow-ask",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "process:allow-restart",
    "process:allow-exit",
    "updater:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/lorebiri/acchiappaspettri/*" },
        { "url": "https://github.com/lorebiri/acchiappaspettri#readme" },
        { "url": "https://lorebiri.github.io/acchiappaspettri/*" },
        { "url": "mailto:*" },
        { "url": "https://doi.org/*" }
      ]
    }
  ]
}
