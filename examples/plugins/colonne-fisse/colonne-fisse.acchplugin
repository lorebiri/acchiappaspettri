{
 "format": "acchplugin",
 "formatVersion": 1,
 "manifest": {
  "id": "org.acchiappaspettri.esempio.colonne-fisse",
  "name": "Colonne fisse (esempio)",
  "version": "1.0.0",
  "author": "Lorenzo Birindelli",
  "license": "GPL-3.0-or-later",
  "extensions": [
   "fwf"
  ],
  "minAppVersion": "3.0.0",
  "permissions": [
   "read-file"
  ],
  "description": {
   "it": "Esempio dimostrativo: legge file di testo a colonne di larghezza fissa (ACCH-FWF 1), una colonna x e uno o più canali y.",
   "en": "Demonstration example: reads fixed-width text files (ACCH-FWF 1), one x column and one or more y channels."
  },
  "homepage": "https://github.com/lorebiri/acchiappaspettri/blob/main/docs/ESTENSIONI.md"
 },
 "code": "// SPDX-FileCopyrightText: 2026 Lorenzo Birindelli\n// SPDX-License-Identifier: GPL-3.0-or-later\n/* Estensione d'esempio di Acchiappaspettri: file di testo a colonne di larghezza fissa («ACCH-FWF 1»).\n   Formato (inventato per l'esempio, documentato in docs/ESTENSIONI.md):\n     # ACCH-FWF 1                               prima riga: firma del formato\n     # columns: x 1-10 | A 11-20 | B 21-30     colonne: nome, primo e ultimo carattere (da 1, inclusi); la prima è x\n     # technique: uv                            facoltativa: tecnica di Acchiappaspettri (ftir, raman, uv, fluo, hplc, …)\n     # sample: nome                             facoltativa: nome del campione\n     # qualsiasi altra riga con # è un'informazione (meta)\n     poi una riga di numeri per punto, ogni numero nella sua colonna; virgola o punto decimale.\n   Gira nel worker isolato dell'app: niente DOM, niente rete. Restituisce null se il file non è in questo formato. */\nregisterReader(function(bytes, name){\n  var text=new TextDecoder('utf-8').decode(bytes);\n  if (text.charCodeAt(0)===0xFEFF) text=text.slice(1);\n  var lines=text.split(/\\r\\n|\\n|\\r/);\n  if (!/^#\\s*ACCH-FWF\\s+1\\s*$/.test(lines[0]||'')) return null;   // non è un file di questo formato: lo legge l'app, se sa farlo\n  var cols=null, technique=null, sample='', meta=[];\n  var i, m;\n  for (i=1; i<lines.length && /^\\s*#/.test(lines[i]); i++){\n    var h=lines[i].replace(/^\\s*#\\s?/,'');\n    if ((m=/^columns\\s*:\\s*(.+)$/i.exec(h))){\n      cols=m[1].split('|').map(function(s){ var c=/^\\s*(.+?)\\s+(\\d+)\\s*-\\s*(\\d+)\\s*$/.exec(s); if (!c || +c[2]<1 || +c[3]<+c[2]) return null; return {name:c[1], a:+c[2]-1, b:+c[3]}; });\n      if (cols.length<2 || cols.some(function(c){ return !c; })) return {error:'riga «columns» non valida: servono almeno due colonne «nome inizio-fine» / invalid «columns» line'};\n    } else if ((m=/^technique\\s*:\\s*(\\w+)\\s*$/i.exec(h))) technique=m[1].toLowerCase();\n    else if ((m=/^sample\\s*:\\s*(.+)$/i.exec(h))) sample=m[1].trim();\n    else if (h.trim()) meta.push(h.trim());\n  }\n  if (!cols) return {error:'manca la riga «# columns:» / missing «# columns:» line'};\n  var xs=[], ys=cols.slice(1).map(function(){ return []; });\n  for (; i<lines.length; i++){\n    var L=lines[i]; if (!L.trim()) continue;\n    for (var k=0; k<cols.length; k++){\n      var cell=L.slice(cols[k].a, cols[k].b).trim().replace(',', '.');\n      var v=/^[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?$/.test(cell) ? parseFloat(cell) : NaN;\n      if (!isFinite(v)) return {error:'riga '+(i+1)+', colonna «'+cols[k].name+'»: «'+cell+'» non è un numero / line '+(i+1)+', column «'+cols[k].name+'»: not a number'};\n      if (k===0) xs.push(v); else ys[k-1].push(v);\n    }\n  }\n  return {\n    sample: sample,\n    technique: technique,\n    meta: ['Formato: ACCH-FWF 1 (colonne fisse)', 'x: '+cols[0].name].concat(meta),\n    channels: cols.slice(1).map(function(c, k){ return {name:c.name, x:xs, y:ys[k]}; })\n  };\n});\n",
 "examples": [
  {
   "name": "esempio-SINTETICO.fwf",
   "data": "",
   "expected": {
    "technique": "uv",
    "channels": [
     {
      "name": "A 254 nm",
      "x": [
       240,
       245,
       250,
       255,
       260,
       265,
       270,
       275,
       280,
       285
      ],
      "y": [
       0.12,
       0.24,
       0.41,
       0.5,
       0.43,
       0.29,
       0.18,
       0.11,
       0.07,
       0.05
      ]
     },
     {
      "name": "B 280 nm",
      "x": [
       240,
       245,
       250,
       255,
       260,
       265,
       270,
       275,
       280,
       285
      ],
      "y": [
       0.05,
       0.08,
       0.13,
       0.21,
       0.32,
       0.42,
       0.49,
       0.44,
       0.31,
       0.17
      ]
     }
    ]
   }
  }
 ]
}
