    affiliation: "Consiglio Nazionale delle Ricerche, Istituto di Chimica dei Composti OrganoMetallici (CNR-ICCOM), Pisa, Italy"
version: "2.2.0"
license: GPL-3.0-or-later
repository-code: "https://github.com/lorebiri/acchiappaspettri"
url: "https://lorebiri.github.io/acchiappaspettri/"
keywords:
  - spectroscopy
  - chromatography
  - FTIR
  - Raman
  - XRF
  - HPLC
  - cultural heritage
  - analytical chemistry
references:
